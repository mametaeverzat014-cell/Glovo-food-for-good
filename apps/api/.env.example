# PostgreSQL connection string (Supabase / Railway / local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/foodsave?schema=public"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS="http://localhost:3000"

# Public URL of the web app (used to build Stripe success/cancel redirects).
# Falls back to the first CORS origin if unset.
WEB_URL="http://localhost:3000"

# Stripe (test mode). Get a test secret key at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."

# AI offer assistant. Works with NO key (built-in generator). For LLM-quality
# copy, add a FREE Groq key (https://console.groq.com/) — recommended:
# GROQ_API_KEY="gsk_..."
# GROQ_MODEL="llama-3.3-70b-versatile"
# Or any OpenAI-compatible provider, e.g. xAI Grok (paid): XAI_API_KEY / XAI_MODEL
